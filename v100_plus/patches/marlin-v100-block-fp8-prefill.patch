+
+// Explicit block-scale contract; the generic FP8 operator permits scales that
+// vary per N column and must retain its original metadata interpretation.
+torch::Tensor sm70_block_fp8_moe_gemm(
+    torch::Tensor a, torch::Tensor c, torch::Tensor w, torch::Tensor scales,
+    torch::Tensor sorted, torch::Tensor experts, torch::Tensor count,
+    torch::Tensor weights, int64_t block_size, int64_t top_k, bool mul_weights,
+    int64_t m, int64_t n, int64_t k) {
+  c10::cuda::CUDAGuard guard(a.device());
+  TORCH_CHECK(m > 0 && top_k > 0 && n % 256 == 0 && k % 128 == 0,
+              "SM70 block-FP8 requires positive M/top_k, N % 256 == 0 and K % 128 == 0");
+  TORCH_CHECK(block_size == 8 || block_size == 16 || block_size == 32 ||
+                  block_size == 48 || block_size == 64,
+              "Unsupported SM70 block-FP8 route alignment");
+  TORCH_CHECK(a.scalar_type() == at::kHalf && c.scalar_type() == at::kHalf &&
+                  scales.scalar_type() == at::kHalf && w.scalar_type() == at::kInt,
+              "SM70 block-FP8 expects FP16 activations/output/scales and int32 packed weights");
+  TORCH_CHECK(a.dim() == 2 && a.size(0) == m && a.size(1) == k &&
+                  c.dim() == 2 && c.size(0) == m * top_k && c.size(1) == n &&
+                  w.dim() == 3 && w.size(1) == k / 16 && w.size(2) == n * 4 &&
+                  scales.dim() == 3 && scales.size(0) == w.size(0) &&
+                  scales.size(1) == k / 128 && scales.size(2) == n,
+              "Invalid SM70 block-FP8 tensor shape");
+  for (auto const& tensor : {a, c, w, scales, sorted, experts, count, weights}) {
+    TORCH_CHECK(tensor.is_cuda() && tensor.device() == a.device() && tensor.is_contiguous(),
+                "SM70 block-FP8 requires contiguous tensors on one CUDA device");
+  }
+  TORCH_CHECK(sorted.scalar_type() == at::kInt && experts.scalar_type() == at::kInt &&
+                  count.scalar_type() == at::kInt && count.numel() == 1 &&
+                  weights.scalar_type() == at::kFloat && weights.numel() == m * top_k,
+              "Invalid SM70 block-FP8 routing metadata");
+  using Traits = Sm70MarlinMoeGemmTraits<Sm70MoeFp8GemmSpec<true, true>,
+      32, 256, 32, 4, 32, 64, 32, 128, 256>;
+  auto zeros = torch::empty({0}, scales.options());
+  auto global_scale = torch::empty({0}, scales.options().dtype(at::kFloat));
+  return launch_sm70_marlin_moe_gemm<Traits>(a, c, w, scales, zeros, global_scale,
+      sorted, experts, count, weights, block_size, top_k, mul_weights, m, n, k, 1);
+}

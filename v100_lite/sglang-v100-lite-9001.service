[Unit]
Description=SGLang V100 lite RadixArk test endpoint on GPUs 0-3
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/alexander/my-projects/sglang-v100-lite
EnvironmentFile=/home/alexander/.llama-server/.env
ExecStart=/home/alexander/my-projects/sglang-v100-lite/sglang-server.sh
Restart=on-failure
RestartSec=10
TimeoutStopSec=180
KillMode=control-group
OOMScoreAdjust=900
LimitMEMLOCK=infinity
LimitNOFILE=65536

[Install]
WantedBy=default.target

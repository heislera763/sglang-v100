+  }
+
+  // Down sees the ten routed rows as M=10 with top-k=1.
+  if (ctx.size_m == 10 && ctx.top_k == 1 &&
+      ctx.size_n == 2560 && ctx.size_k == 160) {
+    params = {{64, 256, 32, 4, 64, 64, 32},
+              1,
+              false,
+              ctx.packed_macro_n};
+    return true;
+  }
+
+  return false;
+}
 

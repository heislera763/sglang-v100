+inline bool sm70_marlin_moe_try_select_radixark_qwen3_8_flash_next_nvfp4_params(
+    Sm70MarlinMoeAutoParamsContext const& ctx,
+    Sm70MarlinAutoParams& params) {
+  // RadixArk/Qwen3.8-Flash-Next-NVFP4, TP=4, batch-one decode.  It routes ten
+  // of 512 experts with hidden=2560 and TP-local intermediate=160.  The
+  // checkpoint is ModelOpt NVFP4 (group 16).  An exhaustive V100-SXM2 sweep
+  // measured 73.35 us for gate/up and 83.56 us for down at these shapes.
